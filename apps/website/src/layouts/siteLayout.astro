---
import "../styles/global.css";

import { Header, Footer } from "../components";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "builtwithhabit",
  description = "Personal training and skin-safe activewear from builtwithhabit.",
} = Astro.props;
---

<html lang="en" data-theme="builtwithhabit" class="lowercase">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/bwh-logo-small.png" />
    <link rel="icon" href="/bwh-logo-small.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body
    class="min-h-dvh grid grid-rows-[auto_1fr_auto] bg-base-100 font-sans text-base-content antialiased"
  >
    <Header />
    <main class="w-full min-w-0 overflow-x-hidden">
      <slot />
    </main>
    <Footer />
  </body>
</html>
