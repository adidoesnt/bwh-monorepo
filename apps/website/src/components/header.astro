---
import {
  BLOG_ENABLED,
  PT_ENABLED,
  SEARCH_ENABLED,
  SHOP_ENABLED,
} from "../constants/featureFlags";
import { getNavLinks } from "../constants/navLinks";
import { PT_URL, SHOP_URL } from "../constants/links";
import { Logo, MobileMenu, Navbar, SearchBar } from ".";
import { CartIcon, DumbbellIcon } from "@repo/ui/icons";

const navLinks = getNavLinks({ blogEnabled: BLOG_ENABLED });
---

<header class="sticky top-0 z-50 h-[12dvh] bg-base-100 shadow-md md:h-[17dvh]">
  <div
    class="grid md:grid-cols-3 grid-cols-[1fr_auto] items-center p-4 md:p-8 md:pb-0"
  >
    <div class="hidden md:flex w-full justify-start">
      {SEARCH_ENABLED && <SearchBar client:load />}
    </div>
    <div class="flex w-full md:justify-center justify-start ml-2 md:ml-0">
      <a href="/"><Logo /></a>
    </div>
    <div class="flex w-full justify-end md:gap-1">
      {
        SHOP_ENABLED && (
          <a
            target="_blank"
            href={SHOP_URL}
            class="md:flex hidden btn btn-ghost aspect-square p-1"
          >
            <CartIcon className="md:size-6" />
          </a>
        )
      }
      <MobileMenu
        client:load
        {navLinks}
        shopEnabled={SHOP_ENABLED}
        ptEnabled={PT_ENABLED}
        shopUrl={SHOP_URL}
        ptUrl={PT_URL}
      />
      {
        PT_ENABLED && (
          <a
            target="_blank"
            href={PT_URL}
            class="md:flex hidden btn btn-ghost aspect-square p-1"
          >
            <DumbbellIcon className="md:size-6" />
          </a>
        )
      }
    </div>
  </div>
  <div class="md:block hidden">
    <Navbar navLinks={navLinks} />
  </div>
</header>
