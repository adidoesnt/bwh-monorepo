---
import { navLinks } from "../constants/navLinks";
---

<nav class="mt-4 pb-4 drop-shadow-lg font-body">
  <ul
    class="flex items-center justify-center gap-4 leading-none lowercase tracking-tight text-base-content/85"
  >
    {
      navLinks.map((link, index) => (
        <>
          {index > 0 && (
            <li aria-hidden="true" class="text-base-content/60">
              |
            </li>
          )}
          <li>
            <a class="hover:text-base-content" href={link.href}>
              {link.label}
            </a>
          </li>
        </>
      ))
    }
  </ul>
</nav>
