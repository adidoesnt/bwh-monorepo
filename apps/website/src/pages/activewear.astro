---
import { SiteLayout } from "../layouts";
import { BLOG_ENABLED } from "../constants/featureFlags";
import {
  activewearDescriptionParagraphs,
  activewearHeadline,
  waitlistLabel,
} from "../constants";

const visibleDescriptionParagraphs = BLOG_ENABLED
  ? activewearDescriptionParagraphs
  : activewearDescriptionParagraphs.filter(
      (paragraph) => !paragraph.includes("/blog"),
    );
---

<SiteLayout>
  <section
    class="relative isolate flex h-[90dvh] w-full items-center justify-center bg-[url(/activewear-athlete.jpg)] bg-cover bg-center md:h-[85dvh] text-lg md:text-xl"
  >
    <div
      class="absolute inset-0 z-0"
      style="background-color: rgba(255, 255, 255, 0.7);"
    >
    </div>
    <div
      class="relative z-10 flex flex-col items-center justify-center gap-4 font-body text-center p-4 md:p-8"
    >
      <p class="italic">{waitlistLabel}</p>
      <h1 class="font-headings text-3xl font-bold">{activewearHeadline}</h1>
      {
        visibleDescriptionParagraphs.map((paragraph) =>
          paragraph.includes("<") ? (
            <p set:html={paragraph} />
          ) : (
            <p>{paragraph}</p>
          ),
        )
      }
    </div>
  </section>
</SiteLayout>
