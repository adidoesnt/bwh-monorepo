---
import { SiteLayout } from "../layouts";
import { MissionSection } from "../components";
import { journeyLinkText, whyParagraphs, whySectionTitle } from "../constants";
---

<SiteLayout>
  <section
    id="why-section"
    class="bg-base-200 grid min-h-[50dvh] place-items-center p-4 md:p-8 gap-4"
  >
    <h1
      class="font-headings text-dark-brown text-center text-3xl md:text-4xl font-bold tracking-wide"
    >
      {whySectionTitle}
    </h1>

    <div
      class="grid w-full max-w-6xl gap-4 text-left md:grid-cols-[1fr_2fr] md:gap-8"
    >
      <div
        id="why-image"
        class="flex flex-col gap-4 items-center order-1 w-full max-w-md md:order-1 md:max-w-none md:h-full md:min-h-0"
      >
        <div
          class="relative w-full aspect-4/3 overflow-hidden rounded-sm md:aspect-auto md:h-full md:flex-1 md:min-h-0"
        >
          <img
            src="/why-section-image.jpg"
            alt="Picture of the founder"
            class="absolute inset-0 z-0 h-full w-full object-cover"
          />
        </div>

        <a
          href="/blog"
          class="hidden md:inline-flex text-lg text-dark-brown underline transition-opacity duration-300 hover:opacity-50 font-body mt-4"
        >
          {journeyLinkText}
        </a>
      </div>

      <div id="why-text" class="order-2 flex flex-col gap-4 md:order-2">
        {
          whyParagraphs.map((paragraph) => (
            <p
              class="font-body text-dark-brown text-lg md:text-xl"
              set:html={paragraph}
            />
          ))
        }

        <a
          href="/blog"
          class="inline-flex md:hidden text-dark-brown underline transition-opacity duration-300 hover:opacity-50 font-body mt-4"
        >
          {journeyLinkText}
        </a>
      </div>
    </div>
  </section>

  <MissionSection
    imageSrc="/headshot.png"
    imageAlt="Headshot of the founder"
    sectionClass="bg-base-100 grid min-h-[50dvh] place-items-center py-8 p-4 md:p-8 gap-4"
  />
</SiteLayout>
