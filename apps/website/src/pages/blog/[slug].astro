---
import { SiteLayout } from "../../layouts";
import { BlogDraftDevNotice } from "../../components";
import { BLOG_ENABLED } from "../../constants/featureFlags";
import {
  blogBackLinkLabel,
  blogBackToAllPostsLabel,
  blogBackToTopLabel,
  blogDraftBadgeLabel,
} from "../../constants/blog";
import { formatBlogDate, getPublishedPosts } from "../../utils/blog";
import { getBlogPostingJsonLd } from "../../utils/seo";
import { render } from "astro:content";

export async function getStaticPaths() {
  if (!BLOG_ENABLED) {
    return [];
  }

  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

if (!BLOG_ENABLED) {
  return Astro.redirect("/404");
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, tags, thumbnail, draft } = post.data;
const isDev = import.meta.env.DEV;
const showDraftNotice = isDev && draft;

const blogPostingJsonLd = getBlogPostingJsonLd({
  title,
  description,
  pubDate,
  tags,
  thumbnail,
  slug: post.id,
});
---

<SiteLayout
  title={title}
  description={description}
  image={thumbnail.src}
  type="article"
  jsonLd={blogPostingJsonLd}
>
  <article
    id="blog-post-top"
    class="text-dark-brown bg-beige flex w-full flex-col items-center gap-6 overflow-x-hidden p-4 md:gap-8 md:p-8"
  >
    <div class="flex w-full max-w-5xl flex-col gap-6">
      <a
        href="/blog"
        class="font-body font-bold text-dark-brown hover:opacity-80 w-fit text-lg underline transition-opacity"
      >
        {blogBackLinkLabel}
      </a>

      {showDraftNotice && <BlogDraftDevNotice variant="post" />}

      <div class="bg-white overflow-hidden rounded-sm shadow-md">
        <div class="h-44 w-full overflow-hidden md:h-56">
          <img
            src={thumbnail.src}
            alt={thumbnail.alt}
            class="h-full w-full object-cover"
          />
        </div>

        <div class="flex flex-col gap-6 p-4 md:gap-8 md:p-8">
          <header class="flex flex-col gap-4">
            <h1
              class="font-headings text-3xl font-bold tracking-wide md:text-4xl"
            >
              {title}
            </h1>
            <div class="flex flex-col gap-3">
              <time
                datetime={pubDate.toISOString()}
                class="font-body text-dark-brown/80 text-base"
              >
                {formatBlogDate(pubDate)}
              </time>
              <div class="flex flex-wrap gap-2">
                {
                  tags.map((tag) => (
                    <span class="badge badge-neutral badge-sm font-body">{tag}</span>
                  ))
                }
                {showDraftNotice && (
                  <span class="badge badge-warning badge-sm font-body">{blogDraftBadgeLabel}</span>
                )}
              </div>
            </div>
          </header>

          <hr class="border-dark-brown/15" />

          <div
            class="font-body blog-content text-dark-brown flex flex-col gap-4 text-base md:text-lg"
          >
            <Content />
          </div>

          <nav
            class="border-dark-brown/15 font-body flex flex-col flex-wrap gap-4 border-t pt-6 text-lg"
            aria-label="Post navigation"
          >
            <a
              href="#blog-post-top"
              class="text-dark-brown font-bold hover:opacity-80 underline transition-opacity"
            >
              {blogBackToTopLabel}
            </a>
            <a
              href="/blog"
              class="text-dark-brown font-bold hover:opacity-80 underline transition-opacity"
            >
              {blogBackToAllPostsLabel}
            </a>
          </nav>
        </div>
      </div>
    </div>
  </article>
</SiteLayout>

<style>
  .blog-content :global(h2) {
    font-family: var(--font-headings, serif);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.025em;
  }

  @media (min-width: 768px) {
    .blog-content :global(h2) {
      font-size: 1.875rem;
    }
  }

  .blog-content :global(p),
  .blog-content :global(li) {
    line-height: 1.625;
  }

  .blog-content :global(ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
  }

  .blog-content :global(a) {
    font-weight: 700;
    text-decoration: underline;
    transition: opacity 0.2s;
  }

  .blog-content :global(a:hover) {
    opacity: 0.8;
  }

  .blog-content :global(strong) {
    font-weight: 700;
  }

  .blog-content :global(img) {
    width: 100%;
    height: auto;
    border-radius: 0.125rem;
  }
</style>
