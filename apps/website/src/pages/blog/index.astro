---
import { SiteLayout } from "../../layouts";
import { BlogIndex, BlogDraftDevNotice } from "../../components";
import { BLOG_ENABLED } from "../../constants/featureFlags";
import { blogSectionTitle } from "../../constants/blog";
import { formatBlogDate, getPublishedPosts } from "../../utils/blog";

if (!BLOG_ENABLED) {
  return Astro.redirect("/404");
}

const posts = await getPublishedPosts();
const isDev = import.meta.env.DEV;
const postCards = posts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  description: post.data.description,
  pubDateLabel: formatBlogDate(post.data.pubDate),
  pubDateIso: post.data.pubDate.toISOString(),
  tags: post.data.tags,
  thumbnail: post.data.thumbnail,
  draft: isDev ? post.data.draft : false,
}));
---

<SiteLayout title={blogSectionTitle} description={blogSectionTitle}>
  <section
    id="blog-section"
    class="text-dark-brown bg-beige flex min-h-[50dvh] flex-col place-items-center gap-4 overflow-x-hidden p-4 md:gap-8 md:p-8"
  >
    <h1
      class="font-headings text-dark-brown text-center text-3xl font-bold tracking-wide md:text-4xl"
    >
      {blogSectionTitle}
    </h1>

    {isDev && (
      <div class="w-full max-w-6xl">
        <BlogDraftDevNotice variant="index" />
      </div>
    )}

    <BlogIndex client:load posts={postCards} />
  </section>
</SiteLayout>
