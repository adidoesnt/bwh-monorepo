{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "DATABASE_URL",
        "AUTH_BASE_URL",
        "BETTER_AUTH_SECRET",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_FORCE_PATH_STYLE",
        "S3_AUTO_CREATE_BUCKET",
        "ENABLE_STRIPE_PAYMENTS"
      ]
    }
  }
}
