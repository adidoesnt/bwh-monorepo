# Copy to .env and fill in. Vars marked (optional) have working defaults in
# code and only need setting to override them.

# ── Database ─────────────────────────────────────────────────────────────
# (optional) defaults to the docker-compose postgres
# DATABASE_URL="postgresql://bwh:bwh@localhost:5432/bwh"

# ── Auth ─────────────────────────────────────────────────────────────────
# (optional) defaults to http://localhost:4322/
# AUTH_BASE_URL="http://localhost:4322/"
#
# REQUIRED IN PRODUCTION — signs session tokens; the app throws on boot without
# it. Dev + `vite build` fall back to a throwaway value. Generate one with:
#   openssl rand -base64 32
# BETTER_AUTH_SECRET=""

# ── Object storage (PayNow screenshots etc) ──────────────────────────────
# All optional — defaults target the floci container from docker-compose.
# Set these in production to point at real S3.
# S3_ENDPOINT="http://localhost:4566"           # (optional) omit for real AWS S3
# S3_REGION="us-east-1"                         # (optional)
# S3_BUCKET="bwh-uploads"                       # (optional)
# S3_ACCESS_KEY_ID="test"                       # (optional)
# S3_SECRET_ACCESS_KEY="test"                   # (optional)
# S3_FORCE_PATH_STYLE="true"                    # (optional) "false" for real AWS S3
# S3_AUTO_CREATE_BUCKET="true"                  # (optional) dev only — prod provisions the bucket

# ── Payments ─────────────────────────────────────────────────────────────
# (optional) defaults to "false" → PayNow flow. "true" makes checkout throw a
# not-implemented error (stripe is deferred, see docs/ROADMAP.md Phase 4).
# ENABLE_STRIPE_PAYMENTS="false"
