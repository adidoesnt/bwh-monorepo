{
  "name": "bwh-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:website": "turbo run dev --filter=website",
    "dev:portal": "turbo run dev --filter=booking-portal",
    "dev:shop": "turbo run dev --filter=shop",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "bun run --filter=@repo/database db:generate",
    "db:migrate": "bun run --filter=@repo/database db:migrate",
    "db:push": "bun run --filter=@repo/database db:push",
    "db:studio": "bun run --filter=@repo/database db:studio",
    "blog:package": "bash plugins/bwh-blog/scripts/package.sh",
    "blog:write-post": "claude --plugin-dir ./plugins/bwh-blog \"/bwh-blog:write-post\"",
    "blog:toggle-draft": "claude --plugin-dir ./plugins/bwh-blog \"/bwh-blog:toggle-draft\"",
    "blog:publish": "claude --plugin-dir ./plugins/bwh-blog \"/bwh-blog:publish\""
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
